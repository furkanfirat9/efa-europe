generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ArbitrageOrder {
  id                    String   @id @default(cuid())
  ozonOrderId           String   @unique
  amazonTrackingBarcode String
  productName           String?
  quantity              Int      @default(1)
  declaredValue         Float    @default(100)
  lengthMm              Int      @default(300)
  widthMm               Int      @default(200)
  heightMm              Int      @default(150)
  weightGr              Int      @default(1200)
  labelPdfUrl           String?
  labelFileName         String?
  note                  String?
  status                String   @default("wait")
  lsIndocId             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([ozonOrderId])
  @@index([amazonTrackingBarcode])
  @@index([status])
}

model WarehouseReport {
  id          String   @id @default(cuid())
  ozonOrderId String?
  photoId     Int?
  outdocId    String?
  type        String   @default("photo")
  title       String
  description String?
  mediaUrl    String?
  source      String   @default("warehouse")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ozonOrderId])
  @@index([type])
}

model OzonOrder {
  id                  String    @id @default(cuid())
  postingNumber       String    @unique
  orderId             String
  storeId             String    @default("store1")
  status              String
  statusName          String?
  inProcessAt         DateTime?
  shipmentDate        DateTime?
  totalPrice          Float     @default(0)
  currency            String    @default("RUB")
  customerName        String?
  customerCity        String?
  customerRegion      String?
  customerCountry     String?   @default("Россия")
  customerAddressTail String?
  latitude            Float?
  longitude           Float?
  pvzCode             Int?
  deliveryType        String?
  paymentType         String?
  warehouseName       String?
  tplProvider         String?
  deliveryDateBegin   DateTime?
  deliveryDateEnd     DateTime?
  productsJson        Json?
  financialDataJson   Json?
  rawDataJson         Json?
  
  // Tedarik & Arbitraj Bilgileri
  buyPrice            Float?
  buyCurrency         String?   @default("EUR")
  buyPriceTry         Float?
  purchaseDate        DateTime?
  paymentCard         String?
  supplier            String?
  supplierOrderId     String?
  supplierTracking    String?
  productImage        String?
  productOfferId      String?
  productTitle        String?
  netProfit           Float?
  netProfitTry        Float?
  notes               String?

  // Siparişe yüklenen fatura / belge (Vercel Blob, private). Dosya yalnızca
  // /api/siparisler/document üzerinden sunulur; blob adresi istemciye verilmez.
  documentUrl         String?
  documentName        String?
  documentContentType String?
  documentSize        Int?
  documentUploadedAt  DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([postingNumber])
  @@index([orderId])
  @@index([storeId])
  @@index([status])
  @@index([inProcessAt])
  @@index([purchaseDate])
  @@index([customerCity])
  @@index([customerRegion])
}

// Belgeler sayfası (/belgeler): tedarik, hizmet ve Ozon gider belgeleri.
// Dosya Vercel Blob'da private tutulur ve yalnızca /api/belgeler/[id]/file
// üzerinden sunulur; blob adresi istemciye verilmez.
model AccountingDocument {
  id                 String    @id @default(cuid())
  // Şimdilik yalnızca "lenora"; ikinci mağaza eklendiğinde aynı tablo kullanılır.
  store              String    @default("lenora")
  // draft: okundu, onay bekliyor · confirmed: onaylandı, toplamlara girer
  status             String    @default("draft")
  kind               String    @default("invoice")
  platform           String?
  // src/lib/documents/categories.ts içindeki anahtarlardan biri
  category           String?

  documentNo         String?
  // Polonya e-fatura (KSeF) numarası; varsa mükerrer kontrolü bununla yapılır.
  ksefNo             String?
  dedupKey           String?
  documentDate       DateTime? @db.Date
  sellerName         String?
  sellerCountry      String?
  sellerTaxId        String?
  buyerName          String?
  buyerIsOwn         Boolean?
  currency           String?
  // KDV dahil belge toplamı
  totalAmount        Float?
  orderNumber        String?
  // Belgenin ait olduğu Ozon siparişleri (OzonOrder.postingNumber). Tek faturada
  // birden fazla siparişin ürünü olabilir.
  postingNumbers     String[]  @default([])
  // Dosya siparişe yüklenmiş belgeye aitse true olur; belge silinirken dosyaya dokunulmaz.
  fileShared         Boolean   @default(false)
  servicePeriodStart DateTime? @db.Date
  servicePeriodEnd   DateTime? @db.Date

  // TL çevirimi: fatura tarihinde geçerli TCMB kuru (EVDS). Kaydedilen kur sonradan değişmez.
  fxRate             Float?
  fxRateDate         DateTime? @db.Date
  fxSource           String?
  totalTry           Float?

  notes              String?
  // Okuma sırasında çıkan uyarılar (string[])
  warnings           Json?
  aiModel            String?

  fileUrl            String
  fileName           String
  fileContentType    String
  fileSize           Int
  fileHash           String

  lines              AccountingDocumentLine[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([store, fileHash])
  @@index([store, documentDate])
  @@index([store, status])
  @@index([store, dedupKey])
}

model AccountingDocumentLine {
  id          String             @id @default(cuid())
  documentId  String
  document    AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Float?
  // KDV dahil satır tutarı
  amount      Float?
  category    String?
  isShipping  Boolean            @default(false)

  @@index([documentId])
}

// Lenora'nın kestiği satış faturası (e-Arşiv / e-Fatura, UBL-TR).
//
// Faturanın XML'i doğrudan okunur, yapay zekâ kullanılmaz; bu yüzden taslak /
// onay adımı yoktur. Sık kullanılan alanlar ayrı sütunlardadır, faturadaki her
// bilgi ise `data` içinde durur (gömülü şablon, logo ve imza hariç; onlar
// orijinal dosyada saklı).
model SalesInvoice {
  id               String    @id @default(cuid())
  store            String    @default("lenora")

  invoiceNo        String
  // ETTN: faturanın benzersiz kimliği; mükerrer kontrolü bununla yapılır.
  uuid             String
  // EARSIVFATURA, TEMELFATURA, TICARIFATURA …
  profile          String?
  // SATIS, ISTISNA, IADE …
  typeCode         String?
  issueDate        DateTime  @db.Date
  issueTime        String?

  customerName     String?
  customerCountry  String?
  customerCity     String?

  currency         String
  // Ödenecek tutar (KDV dahil)
  totalAmount      Float
  taxExclusive     Float?
  taxAmount        Float?
  allowanceTotal   Float?
  exemptionCode    String?
  exemptionReason  String?

  // Faturanın üzerindeki kur; TL faturada 1.
  fxRate           Float?
  fxSource         String?
  totalTry         Float?

  // Notlardaki "Gönderi No: …" ile gelen Ozon gönderi numarası; tahmin yürütülmez.
  postingNumber    String?
  // Faturadaki notlar (string[])
  notes            Json?
  // Faturanın tamamı
  data             Json

  // Yüklenen orijinal dosya (GİB ZIP'i ya da UBL XML)
  fileUrl          String
  fileName         String
  fileContentType  String
  fileSize         Int
  fileHash         String

  // Kullanıcının sonradan eklediği PDF
  pdfUrl           String?
  pdfName          String?
  pdfSize          Int?

  lines            SalesInvoiceLine[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([store, uuid])
  @@index([store, issueDate])
  @@index([postingNumber])
}

model SalesInvoiceLine {
  id           String       @id @default(cuid())
  invoiceId    String
  invoice      SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position     Int
  name         String
  quantity     Float?
  unitCode     String?
  unitPrice    Float?
  // KDV hariç satır tutarı
  amount       Float?
  taxPercent   Float?
  gtip         String?
  originCountry String?

  @@index([invoiceId])
}

// Panel kullanıcısı. Kullanıcı adı ve şifre terminalden `npm run kullanici` ile
// belirlenir; şifre yalnızca scrypt özeti olarak saklanır, düz metin tutulmaz.
model PanelUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Bir ayın Ozon'dan çekilip çekilmediğini işaretler.
//
// Siparişler sayfasında bir aya ilk girildiğinde o ay Ozon'dan indirilip veri
// tabanına yazılır; sonraki girişlerde doğrudan veri tabanından okunur. Bu
// kaydın varlığı "bu dönem indirildi" demektir. İçinde bulunulan ay istisnadır:
// yeni sipariş akmaya devam ettiği için kısa aralıklarla tazelenir.
//
// Ayrı bir tabloda tutulmasının sebebi, "o döneme ait sipariş var mı" diye
// bakmanın yetmemesi: eski 30 günlük senkron bazı ayları yarım doldurmuş
// olabiliyor ve boş geçen bir ay her ziyarette yeniden sorulurdu.
model OrderPeriodSync {
  id         String   @id @default(cuid())
  storeId    String
  year       Int
  month      Int
  orderCount Int      @default(0)
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([storeId, year, month])
}

// Panelden yüklenen ürünlerin hafızası (eskiden data/catalog_memory.json).
//
// İki işe yarar: yapay zekâya aynı marka/kategorideki geçmiş yüklemeleri
// (kart birleştirme kodu, vitrin model adı) referans olarak vermek ve Amazon
// avcısında "bu ASIN zaten yüklendi mi" kontrolü. Dosyada tutulduğu sürece
// Vercel'den yapılan yüklemeler hafızaya yazılamıyordu; veri tabanı her
// ortamdan yazılabilir.
model CatalogMemory {
  id                  String    @id @default(cuid())
  asin                String?
  brand               String
  modelNo             String
  categoryId          Int?
  typeId              Int?
  categoryName        String?
  typeName            String?
  // ID 9048 (örn: ph-3000-airfryer)
  seriesMergeCode     String?
  // ID 12141 / 20776 (örn: NA350/00 9 л с двумя чашами 2750 Вт)
  namingTemplateModel String?
  // ID 4381
  partNumber          String?
  aspects             Json?
  finalTitle          String?
  productQuery        String?
  ozonTaskId          String?
  // Mağazadaki ürünle eşleştirilmiş kayıtlarda (ASIN eşleştirme script'i)
  offerId             String?
  ozonProductId       String?
  source              String?
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([asin])
  @@index([brand, modelNo])
}
