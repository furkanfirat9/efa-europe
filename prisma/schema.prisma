generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ArbitrageOrder {
  id                    String   @id @default(cuid())
  ozonOrderId           String   @unique
  amazonTrackingBarcode String
  productName           String?
  quantity              Int      @default(1)
  declaredValue         Float    @default(100)
  lengthMm              Int      @default(300)
  widthMm               Int      @default(200)
  heightMm              Int      @default(150)
  weightGr              Int      @default(1200)
  labelPdfUrl           String?
  labelFileName         String?
  note                  String?
  status                String   @default("wait")
  lsIndocId             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([ozonOrderId])
  @@index([amazonTrackingBarcode])
  @@index([status])
}

model WarehouseReport {
  id          String   @id @default(cuid())
  ozonOrderId String?
  photoId     Int?
  outdocId    String?
  type        String   @default("photo")
  title       String
  description String?
  mediaUrl    String?
  source      String   @default("warehouse")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ozonOrderId])
  @@index([type])
}

model OzonOrder {
  id                  String    @id @default(cuid())
  postingNumber       String    @unique
  orderId             String
  storeId             String    @default("store1")
  status              String
  statusName          String?
  inProcessAt         DateTime?
  shipmentDate        DateTime?
  totalPrice          Float     @default(0)
  currency            String    @default("RUB")
  customerName        String?
  customerCity        String?
  customerRegion      String?
  customerCountry     String?   @default("Россия")
  customerAddressTail String?
  latitude            Float?
  longitude           Float?
  pvzCode             Int?
  deliveryType        String?
  paymentType         String?
  warehouseName       String?
  tplProvider         String?
  deliveryDateBegin   DateTime?
  deliveryDateEnd     DateTime?
  productsJson        Json?
  financialDataJson   Json?
  rawDataJson         Json?
  
  // Tedarik & Arbitraj Bilgileri
  buyPrice            Float?
  buyCurrency         String?   @default("EUR")
  buyPriceTry         Float?
  purchaseDate        DateTime?
  paymentCard         String?
  supplier            String?
  supplierOrderId     String?
  supplierTracking    String?
  productImage        String?
  productOfferId      String?
  productTitle        String?
  netProfit           Float?
  netProfitTry        Float?
  // Kâr dökümü (src/lib/orders/profit.ts). 'ozon': Ozon'un gerçek kesintileri tahakkuk etti,
  // 'estimate': kesintiler tarifeden tahmin. profitCheckedAt: Ozon'a en son ne zaman soruldu.
  profitSource        String?
  profitJson          Json?
  profitCheckedAt     DateTime?
  notes               String?

  // Siparişe yüklenen fatura / belge (Vercel Blob, private). Dosya yalnızca
  // /api/siparisler/document üzerinden sunulur; blob adresi istemciye verilmez.
  documentUrl         String?
  documentName        String?
  documentContentType String?
  documentSize        Int?
  documentUploadedAt  DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([postingNumber])
  @@index([orderId])
  @@index([storeId])
  @@index([status])
  @@index([inProcessAt])
  @@index([purchaseDate])
  @@index([customerCity])
  @@index([customerRegion])
}

// Belgeler sayfası (/belgeler): tedarik, hizmet ve Ozon gider belgeleri.
// Dosya Vercel Blob'da private tutulur ve yalnızca /api/belgeler/[id]/file
// üzerinden sunulur; blob adresi istemciye verilmez.
model AccountingDocument {
  id                 String    @id @default(cuid())
  // Şimdilik yalnızca "lenora"; ikinci mağaza eklendiğinde aynı tablo kullanılır.
  store              String    @default("lenora")
  // draft: okundu, onay bekliyor · confirmed: onaylandı, toplamlara girer
  status             String    @default("draft")
  kind               String    @default("invoice")
  platform           String?
  // src/lib/documents/categories.ts içindeki anahtarlardan biri
  category           String?

  documentNo         String?
  // Polonya e-fatura (KSeF) numarası; varsa mükerrer kontrolü bununla yapılır.
  ksefNo             String?
  dedupKey           String?
  documentDate       DateTime? @db.Date
  sellerName         String?
  sellerCountry      String?
  sellerTaxId        String?
  buyerName          String?
  buyerIsOwn         Boolean?
  currency           String?
  // KDV dahil belge toplamı
  totalAmount        Float?
  orderNumber        String?
  // Belgenin ait olduğu Ozon siparişleri (OzonOrder.postingNumber). Tek faturada
  // birden fazla siparişin ürünü olabilir.
  postingNumbers     String[]  @default([])
  // Dosya siparişe yüklenmiş belgeye aitse true olur; belge silinirken dosyaya dokunulmaz.
  fileShared         Boolean   @default(false)
  servicePeriodStart DateTime? @db.Date
  servicePeriodEnd   DateTime? @db.Date

  // TL çevirimi: fatura tarihinde geçerli TCMB kuru (EVDS). Kaydedilen kur sonradan değişmez.
  fxRate             Float?
  fxRateDate         DateTime? @db.Date
  fxSource           String?
  totalTry           Float?

  notes              String?
  // Okuma sırasında çıkan uyarılar (string[])
  warnings           Json?
  aiModel            String?

  fileUrl            String
  fileName           String
  fileContentType    String
  fileSize           Int
  fileHash           String

  lines              AccountingDocumentLine[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([store, fileHash])
  @@index([store, documentDate])
  @@index([store, status])
  @@index([store, dedupKey])
}

model AccountingDocumentLine {
  id          String             @id @default(cuid())
  documentId  String
  document    AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Float?
  // KDV dahil satır tutarı
  amount      Float?
  category    String?
  isShipping  Boolean            @default(false)

  @@index([documentId])
}

// Lenora'nın kestiği satış faturası (e-Arşiv / e-Fatura, UBL-TR).
//
// Faturanın XML'i doğrudan okunur, yapay zekâ kullanılmaz; bu yüzden taslak /
// onay adımı yoktur. Sık kullanılan alanlar ayrı sütunlardadır, faturadaki her
// bilgi ise `data` içinde durur (gömülü şablon, logo ve imza hariç; onlar
// orijinal dosyada saklı).
model SalesInvoice {
  id               String    @id @default(cuid())
  store            String    @default("lenora")

  invoiceNo        String
  // ETTN: faturanın benzersiz kimliği; mükerrer kontrolü bununla yapılır.
  uuid             String
  // EARSIVFATURA, TEMELFATURA, TICARIFATURA …
  profile          String?
  // SATIS, ISTISNA, IADE …
  typeCode         String?
  issueDate        DateTime  @db.Date
  issueTime        String?

  customerName     String?
  customerCountry  String?
  customerCity     String?

  currency         String
  // Ödenecek tutar (KDV dahil)
  totalAmount      Float
  taxExclusive     Float?
  taxAmount        Float?
  allowanceTotal   Float?
  exemptionCode    String?
  exemptionReason  String?

  // Faturanın üzerindeki kur; TL faturada 1.
  fxRate           Float?
  fxSource         String?
  totalTry         Float?

  // Notlardaki "Gönderi No: …" ile gelen Ozon gönderi numarası; tahmin yürütülmez.
  postingNumber    String?
  // Faturadaki notlar (string[])
  notes            Json?
  // Faturanın tamamı
  data             Json

  // Yüklenen orijinal dosya (GİB ZIP'i ya da UBL XML)
  fileUrl          String
  fileName         String
  fileContentType  String
  fileSize         Int
  fileHash         String

  // Kullanıcının sonradan eklediği PDF
  pdfUrl           String?
  pdfName          String?
  pdfSize          Int?

  lines            SalesInvoiceLine[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([store, uuid])
  @@index([store, issueDate])
  @@index([postingNumber])
}

model SalesInvoiceLine {
  id           String       @id @default(cuid())
  invoiceId    String
  invoice      SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position     Int
  name         String
  quantity     Float?
  unitCode     String?
  unitPrice    Float?
  // KDV hariç satır tutarı
  amount       Float?
  taxPercent   Float?
  gtip         String?
  originCountry String?

  @@index([invoiceId])
}

// Panel kullanıcısı. Kullanıcı adı ve şifre terminalden `npm run kullanici` ile
// belirlenir; şifre yalnızca scrypt özeti olarak saklanır, düz metin tutulmaz.
model PanelUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Bir ayın Ozon'dan çekilip çekilmediğini işaretler.
//
// Siparişler sayfasında bir aya ilk girildiğinde o ay Ozon'dan indirilip veri
// tabanına yazılır; sonraki girişlerde doğrudan veri tabanından okunur. Bu
// kaydın varlığı "bu dönem indirildi" demektir. İçinde bulunulan ay istisnadır:
// yeni sipariş akmaya devam ettiği için kısa aralıklarla tazelenir.
//
// Ayrı bir tabloda tutulmasının sebebi, "o döneme ait sipariş var mı" diye
// bakmanın yetmemesi: eski 30 günlük senkron bazı ayları yarım doldurmuş
// olabiliyor ve boş geçen bir ay her ziyarette yeniden sorulurdu.
model OrderPeriodSync {
  id         String   @id @default(cuid())
  storeId    String
  year       Int
  month      Int
  orderCount Int      @default(0)
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([storeId, year, month])
}

// Panelden yüklenen ürünlerin hafızası (eskiden data/catalog_memory.json).
//
// İki işe yarar: yapay zekâya aynı marka/kategorideki geçmiş yüklemeleri
// (kart birleştirme kodu, vitrin model adı) referans olarak vermek ve Amazon
// avcısında "bu ASIN zaten yüklendi mi" kontrolü. Dosyada tutulduğu sürece
// Vercel'den yapılan yüklemeler hafızaya yazılamıyordu; veri tabanı her
// ortamdan yazılabilir.
model CatalogMemory {
  id                  String    @id @default(cuid())
  asin                String?
  brand               String
  modelNo             String
  categoryId          Int?
  typeId              Int?
  categoryName        String?
  typeName            String?
  // ID 9048 (örn: ph-3000-airfryer)
  seriesMergeCode     String?
  // ID 12141 / 20776 (örn: NA350/00 9 л с двумя чашами 2750 Вт)
  namingTemplateModel String?
  // ID 4381
  partNumber          String?
  aspects             Json?
  finalTitle          String?
  productQuery        String?
  ozonTaskId          String?
  // Mağazadaki ürünle eşleştirilmiş kayıtlarda (ASIN eşleştirme script'i)
  offerId             String?
  ozonProductId       String?
  source              String?
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([asin])
  @@index([brand, modelNo])
}

// Mağazadaki her Ozon ürününün hangi Amazon ASIN'ine bağlı olduğunun tek kaynağı.
// CatalogMemory yükleme anındaki yapay zekâ referansıdır; bu tablo ise ürünün
// ASIN'inin Amazon sayfasıyla (marka + model numarası) doğrulanıp doğrulanmadığını,
// son okunan fiyatı ve stoğu tutar.
model ProductSource {
  id              String    @id @default(cuid())
  storeId         String    @default("store1")
  ozonProductId   String
  offerId         String
  sku             String?
  ozonName        String?
  ozonBrand       String?
  // Ozon ID 4381 (parça numarası)
  ozonPartNumber  String?
  ozonImage       String?
  asin            String?
  // VERIFIED (model no. birebir) | LIKELY (ek farkı / yalnız başlıkta) | MODEL_MISMATCH |
  // SUSPECT | UNREADABLE | MISSING | MANUAL (elle onaylandı) | NOT_ON_AMAZON (elle: Amazon'da satılmıyor)
  asinStatus      String    @default("MISSING")
  // product_id | offer_id | model | search | manual
  linkMethod      String?
  // Karşılaştırma ayrıntısı: brand, modelExact, modelPrefix, modelInTitle, accessory, imageDist,
  // ozonQty, amzQty, packMismatch
  checks          Json?
  amzTitle        String?
  amzBrand        String?
  amzModel        String?
  amzImage        String?
  // Amazon "Artikelgewicht" ve (varsa) "Verpackungsabmessungen … ; N Gramm"; kargo fiziksel ağırlıktan hesaplanır
  amzItemWeightG    Int?
  amzPackageWeightG Int?
  // Amazon Business sayfasında görünen "Neu" teklifi; KDV oranı ürünün gönderildiği
  // depoya göre değişebildiği için iki fiyat da sayfadan olduğu gibi alınır.
  priceNetEur     Float?
  priceGrossEur   Float?
  listPriceEur    Float?
  availability    String?
  inStock         Boolean?
  soldBy          String?
  soldByAmazon    Boolean?
  deliveryText    String?
  checkedAt       DateTime?
  verifiedAt      DateTime?
  // Ceneo.pl (Polonya fiyat karşılaştırma): tarama uygulamanın tarayıcısında yapılır (skill ceneo-scan).
  // EXACT (kod birebir) | VARIANT (aynı ana model, farklı "/" eki; elle onay) | NOT_FOUND (taramada bulunamadı)
  // | MANUAL (elle bağlandı) | NOT_IN_POLAND (elle: Ceneo'da yok → Amazon.de / amazon.pl; eski adıyla kaldı) | ERROR
  // Boş: hiç eşleşmedi. Kararlar /ceneo-kontrol ekranında verilir.
  ceneoStatus     String?
  ceneoProductId  String?
  ceneoName       String?
  // Eşleşen kod: Ozon parça no. değil Amazon modeliyse kart ile kaynak farklı olabilir (NA352/00 ↔ NA552/00)
  ceneoMatchedCode String?
  // Ceneo ürün sayfasındaki "Waga"; Amazon ağırlığı yoksa kargo hesabına yedek
  ceneoWeightG    Int?
  // Tüm teklifler olduğu gibi; kaynak seçimi okurken yapılır (src/lib/sourcing/ceneoRules.ts), kural değişince tarama gerekmez
  ceneoOffers     Json?
  // VARIANT / NOT_FOUND kararı için aramada çıkan adaylar
  ceneoCandidates Json?
  ceneoCheckedAt  DateTime?
  // Amazon.pl (3. tedarik kanalı): aynı ASIN'in Polonya sayfası, tarayıcıda okunur (skill amazon-scan, __runScanPl).
  // Hesap orada Business değil: fiyat yalnız %23 KDV dahil zloti.
  plTitle         String?
  plPricePln      Float?
  plListPricePln  Float?
  plAvailability  String?
  plInStock       Boolean?
  plSoldBy        String?
  plSoldByAmazon  Boolean?
  plDeliveryText  String?
  plCheckedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([storeId, ozonProductId])
  @@index([asin])
  @@index([asinStatus])
}

// Fiyat endeksi geçmişi. Ozon yalnızca anlık endeksi veriyor; renk değişimini ve sebebini
// (biz mi, rakip mi, Ozon'un yeniden hesabı mı) görmek için durum kaydedilir.
//
// Her kontrol bir PriceIndexRun'dır (mağazanın renk dağılımı, ör. kazançlı %38 → %31).
// Ürün satırı yalnızca durumu bir önceki kayda göre değiştiyse yazılır; böylece bir ürünün
// satırları doğrudan o ürünün değişim geçmişidir.
model PriceIndexRun {
  id           String   @id @default(cuid())
  storeId      String
  takenAt      DateTime @default(now())
  total        Int
  green        Int
  yellow       Int
  red          Int
  withoutIndex Int

  @@index([storeId, takenAt])
}

model PriceIndexSnapshot {
  id                 String   @id @default(cuid())
  storeId            String
  runId              String
  productId          String
  offerId            String
  takenAt            DateTime
  // GREEN | YELLOW | RED | WITHOUT_INDEX
  color              String
  // Müşterinin gördüğü fiyat (kampanya dahil, marketing_seller_price), mağaza para biriminde
  price              Float
  basePrice          Float
  // En ucuz Ozon rakibi: ruble ve Ozon'un mağaza para birimine çevirdiği hâli
  ozonMinPrice       Float?
  ozonMinPriceSeller Float?
  ozonIndex          Float?
  extMinPriceSeller  Float?
  extIndex           Float?

  @@index([storeId, productId, takenAt])
  @@index([storeId, takenAt])
}

// Tedarik fiyat taramalarının kaydı (scripts/supply_scan.mjs, Windows Görev Zamanlayıcı ile her sabah).
// /fiyat-onerisi ve 17:00 hatırlatması son taramanın durumunu buradan okur.
model SupplyScanRun {
  id           String    @id @default(cuid())
  // amazon-de | amazon-pl | ceneo
  channel      String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  // running | ok | partial (bir kısmı okunamadı / bekletildi) | error (oturum, CAPTCHA, engel)
  status       String
  total        Int       @default(0)
  scanned      Int       @default(0)
  unreadable   Int       @default(0)
  priceChanged Int       @default(0)
  stockChanged Int       @default(0)
  // Fiyatı aşırı oynadığı için yazılmayan ürünler
  held         Int       @default(0)
  error        String?
  summary      Json?

  @@index([channel, startedAt])
}
